///|
/// The zero-build index page: a shell that loads /app.js (vanilla by
/// default; regenerated by the Preact + esbuild scaffold in web/).
fn index_html_t(name : String) -> String {
  join_lines([
    "<!doctype html>",
    "<html>",
    "  <head>",
    "    <meta charset=\"utf-8\" />",
    "    <title>\{name}</title>",
    "  </head>",
    "  <body>",
    "    <h1>\{name}</h1>",
    "    <div id=\"app\"></div>",
    "    <script src=\"/app.js\"></script>",
    "  </body>",
    "</html>",
  ])
}

///|
/// Vanilla client wired to the scaffolded posts API — works with no build
/// step. The web/ scaffold replaces this file with the Preact version.
fn app_js_t(_name : String) -> String {
  join_lines([
    "async function loadPosts() {", "  const app = document.getElementById(\"app\");",
    "  try {", "    const res = await fetch(\"/posts\");", "    const posts = await res.json();",
    "    const items = posts", "      .map((p) => `<li>#${p.id} ${p.title}${p.published ? \"\" : \" (draft)\"}</li>`)",
    "      .join(\"\");", "    app.innerHTML = `<ul>${items}</ul><form id=\"new\"><input name=\"title\" placeholder=\"title\" /><input name=\"body\" placeholder=\"body\" /><button>add post</button></form>`;",
    "    document.getElementById(\"new\").onsubmit = async (e) => {", "      e.preventDefault();",
    "      const form = e.target;", "      const id = Date.now();", "      await fetch(\"/posts\", {",
    "        method: \"POST\",", "        headers: { \"Content-Type\": \"application/json\" },",
    "        body: JSON.stringify({ id, title: form.title.value, body: form.body.value, published: true }),",
    "      });", "      loadPosts();", "    };", "  } catch (err) {", "    app.textContent = \"failed to load posts: \" + err;",
    "  }", "}", "", "loadPosts();",
  ])
}

///|
fn web_package_json_t() -> String {
  join_lines([
    "{", "  \"name\": \"web\",", "  \"private\": true,", "  \"type\": \"module\",",
    "  \"scripts\": {", "    \"build\": \"esbuild src/main.jsx --bundle --outfile=../static/app.js --jsx=automatic\"",
    "  },", "  \"dependencies\": {", "    \"preact\": \"^10.19.0\"", "  },", "  \"devDependencies\": {",
    "    \"esbuild\": \"^0.24.0\"", "  }", "}",
  ])
}

///|
fn web_main_jsx_t(name : String) -> String {
  join_lines([
    "import { h, render } from \"preact\";",
    "",
    "async function posts() {",
    "  const res = await fetch(\"/posts\");",
    "  return res.json();",
    "}",
    "",
    "function App({ posts }) {",
    "  return h(\"div\", null,",
    "    h(\"h1\", null, \"\{name}\"),",
    "    h(\"ul\", null, posts.map((p) => h(\"li\", null, `#${p.id} ${p.title}`))),",
    "  );",
    "}",
    "",
    "posts().then((posts) => {",
    "  render(h(App, { posts }), document.getElementById(\"app\"));",
    "});",
  ])
}
