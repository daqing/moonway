///|
/// HTML shell for the Preact bundle built from app/frontend/.
fn index_html_t(name : String) -> String {
  join_lines([
    "<!doctype html>",
    "<html>",
    "  <head>",
    "    <meta charset=\"utf-8\" />",
    "    <title>\{name}</title>",
    "  </head>",
    "  <body>",
    "    <div id=\"app\"></div>",
    "    <script src=\"/app.js\"></script>",
    "  </body>",
    "</html>",
  ])
}

///|
fn web_package_json_t() -> String {
  join_lines([
    "{", "  \"name\": \"web\",", "  \"private\": true,", "  \"type\": \"module\",",
    "  \"scripts\": {", "    \"build\": \"esbuild src/main.jsx --bundle --outfile=../../static/app.js --jsx=automatic --jsx-import-source=preact\"",
    "  },", "  \"dependencies\": {", "    \"preact\": \"^10.19.0\"", "  },", "  \"devDependencies\": {",
    "    \"esbuild\": \"^0.24.0\"", "  }", "}",
  ])
}

///|
fn web_main_jsx_t(name : String) -> String {
  join_lines([
    "import { render } from \"preact\";",
    "import { useEffect, useState } from \"preact/hooks\";",
    "",
    "function App() {",
    "  const [posts, setPosts] = useState([]);",
    "  const [message, setMessage] = useState(\"\");",
    "",
    "  async function refreshPosts() {",
    "    try {",
    "      const res = await fetch(\"/posts\");",
    "      if (!res.ok) {",
    "        setMessage(\"no posts yet — run: moonway generate scaffold Post title:string body:text published:bool\");",
    "        return;",
    "      }",
    "      setPosts(await res.json());",
    "      setMessage(\"\");",
    "    } catch (err) {",
    "      setMessage(\"failed to load posts: \" + err);",
    "    }",
    "  }",
    "",
    "  useEffect(() => {",
    "    refreshPosts();",
    "  }, []);",
    "",
    "  async function addPost(event) {",
    "    event.preventDefault();",
    "    const form = event.currentTarget;",
    "    const data = new FormData(form);",
    "    const id = posts.reduce((max, post) => Math.max(max, post.id), 0) + 1;",
    "    try {",
    "      const res = await fetch(\"/posts\", {",
    "        method: \"POST\",",
    "        headers: { \"Content-Type\": \"application/json\" },",
    "        body: JSON.stringify({",
    "          id,",
    "          title: data.get(\"title\"),",
    "          body: data.get(\"body\"),",
    "          published: true,",
    "        }),",
    "      });",
    "      if (!res.ok) {",
    "        setMessage(\"failed to add post\");",
    "        return;",
    "      }",
    "      form.reset();",
    "      await refreshPosts();",
    "    } catch (err) {",
    "      setMessage(\"failed to add post: \" + err);",
    "    }",
    "  }",
    "",
    "  return (",
    "    <div>",
    "      <h1>\{name}</h1>",
    "      {message && <p>{message}</p>}",
    "      <ul>",
    "        {posts.map((p) => (",
    "          <li key={p.id}>",
    "            #{p.id} {p.title}{p.published ? \"\" : \" (draft)\"}",
    "          </li>",
    "        ))}",
    "      </ul>",
    "      <form onSubmit={addPost}>",
    "        <input name=\"title\" placeholder=\"title\" />",
    "        <input name=\"body\" placeholder=\"body\" />",
    "        <button>add post</button>",
    "      </form>",
    "    </div>",
    "  );",
    "}",
    "",
    "render(<App />, document.getElementById(\"app\"));",
  ])
}
