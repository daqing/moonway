///|
fn templates_pkg_t() -> String {
  join_lines([
    "import {", "  \"daqing/moon-templ/runtime\" @rt,", "}", "", "supported_targets = \"native\"",
    "", "formatter(ignore: [ \"home_templ.mbt\" ])",
  ])
}

///|
fn pages_src_t() -> String {
  join_lines([
    "///|", "pub fn home_page(name : String) -> String {", "  home(name).to_string()",
    "}",
  ])
}
